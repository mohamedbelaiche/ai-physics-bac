# نسخة قابلة للمشاركة من متغيّرات البيئة — انسخها إلى .env.local وأكمل القيم.
# المفاتيح تبقى على السيرفر فقط ولا تُرفع أبداً إلى Git.

# مفتاح OpenRouter (إلزامي) — أنشئه من https://openrouter.ai/settings/keys
AI_API_KEY=

# نقطة النهاية المتوافقة مع OpenAI (قيمة افتراضية موثّقة)
AI_BASE_URL=https://openrouter.ai/api/v1

# معرّف النموذج (افتراضي: GLM 5.3 Flash عبر OpenRouter)
# لسعر بسيط (~$0.05 لكل مليون رمز إدخال). قائمة الموديلات: https://openrouter.ai/models
# بدائل مجانية (:free) بحدود استخدام يومية: google/gemma-4-31b-it:free · nvidia/nemotron-3-super-120b-a12b:free
AI_MODEL=z-ai/glm-5.3-flash

# اختياري: رابط موقعك للإحالة (ترويسة HTTP-Referer لدى OpenRouter) — املأه بعد أول نشر
AI_SITE_URL=
