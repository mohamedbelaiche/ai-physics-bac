# نسخة قابلة للمشاركة من متغيّرات البيئة — انسخها إلى .env.local وأكمل القيم.
# المفاتيح تبقى على السيرفر فقط ولا تُرفع أبداً إلى Git.

# مفتاح OpenCode Zen (إلزامي) — https://opencode.ai/zen/
AI_API_KEY=

# نقطة النهاية المتوافقة مع OpenAI (قيمة افتراضية موثقة)
AI_BASE_URL=https://opencode.ai/zen/v1

# معرّف النموذج (موثق من قائمة https://opencode.ai/zen/v1/models)
AI_MODEL=glm-5.3-flash
